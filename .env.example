# ─────────────────────────────────────────────
# Arbitrage Dashboard — Environment Configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────

# ── Mode ──────────────────────────────────────
MOCK_MODE=true

# ── Exchange API Keys ──────────────────────────
API_KEY_BINANCE=your_binance_api_key_here
API_SECRET_BINANCE=your_binance_api_secret_here
API_KEY_BACKPACK=your_backpack_api_key_here
API_SECRET_BACKPACK=your_backpack_api_secret_here
API_KEY_BYBIT=your_bybit_api_key_here
API_SECRET_BYBIT=your_bybit_api_secret_here
API_KEY_DEX=your_dextrade_api_key_here
API_SECRET_DEX=your_dextrade_api_secret_here

# ── Capital ────────────────────────────────────
STARTING_CAPITAL=500.0
TRADE_AMOUNT=100.0
KILL_SWITCH_BALANCE=450.0

# ── Thresholds ─────────────────────────────────
TRIGGER_THRESHOLD=1.8
FRICTION_BUDGET=0.4

# ── Risk Controls ──────────────────────────────
DAILY_LOSS_CAP=30.0
CONSEC_LOSS_MAX=3
PAUSE_MINUTES=15

# ── Telegram Alerts ────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Logging ────────────────────────────────────
LOG_LEVEL=INFO

# ── TimescaleDB Connection ─────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arb_bot
DB_USER=arb_user
DB_PASSWORD=arb_dev_pass
DB_MIN_POOL=2
DB_MAX_POOL=10

# ── Feature Flags (Shadow Mode) ────────────────
# DB_WRITE_ENABLED: write opportunities to TimescaleDB alongside CSV
# DB_READ_ENABLED:  read analytics/recent from TimescaleDB instead of CSV
DB_WRITE_ENABLED=true
DB_READ_ENABLED=false
